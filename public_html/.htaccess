# ============================================================================
# YSL — .htaccess  (LiteSpeed / Apache on Hostinger).  CLAUDE.md §1, §8.
# Force HTTPS · canonical host · front-controller rewrite · security headers ·
# deny app/config/docs/dotfiles/json · no dir listing · long asset caching.
# ============================================================================

Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # --- Force HTTPS (301) --------------------------------------------------
    RewriteCond %{HTTPS} !=on [OR]
    RewriteCond %{HTTP:X-Forwarded-Proto} =http
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # --- Canonical host: pick ONE of www / non-www (301 the other) ----------
    # Uncomment the pair that matches the launch decision (site.json base_url).
    # Default here = www. (see CONTENT-TODO: confirm canonical host at launch)
    # RewriteCond %{HTTP_HOST} !^www\. [NC]
    # RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
    #
    # non-www variant:
    # RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    # RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

    # --- Front controller: route everything that isn't a real file to index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>

# --- Security headers --------------------------------------------------------
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    # CSP: self only, plus Google Maps embed (Contact page). No inline JS.
    # 'unsafe-inline' for style- is scoped to attributes used in scaffold/templates;
    # tighten to hashes/nonces once inline styles are removed.
    Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; img-src 'self' data: https://maps.gstatic.com https://*.googleapis.com; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; frame-src https://www.google.com https://maps.google.com; form-action 'self'; frame-ancestors 'self'"
    # Do not leak PHP version
    Header always unset X-Powered-By
</IfModule>

# --- Deny access to non-public paths (defence in depth; app/ & config/ should
#     live ABOVE public_html in production — §12) ------------------------------
RedirectMatch 403 (?i)^/(app|config|docs|reference)(/|$)

# Block dotfiles (.git, .env, .htaccess itself, etc.)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Block raw data / config / markdown from being served
<FilesMatch "\.(json|md|ini|log|example\.php|rtf)$">
    Require all denied
</FilesMatch>

# --- Long cache for static assets -------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css               "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType font/woff2             "access plus 1 year"
    ExpiresByType image/webp             "access plus 1 year"
    ExpiresByType image/svg+xml          "access plus 1 year"
    ExpiresByType image/png              "access plus 1 year"
    ExpiresByType image/jpeg             "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|woff2|webp|svg|png|jpe?g)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# --- Compression -------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>
